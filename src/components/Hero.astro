---
import { profile } from "../data/profile";
import Icon from "./Icons.astro";
---

<header class="hero">
  <div class="wrap">
    <nav class="topbar reveal">
      <span class="reg-label"><span class="hex">0x000</span> · {profile.name.toUpperCase()}</span>
      <div class="nav-right">
        <div class="nav-links mono">
          <a href="#projects">projects</a>
          <a href="#experience">experience</a>
          <a href="#skills">skills</a>
          <a href="#contact">contact</a>
        </div>
        <button data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
          </svg>
        </button>
      </div>
    </nav>

    <div class="hero-body">
      <p class="reg-label reveal d1">
        <span class="hex">SIG</span> · {profile.location} · {profile.kanji}
      </p>
      <h1 class="reveal d2">
        Vehicle networks,<br />
        <em>secured</em> by design.
      </h1>
      <p class="lede reveal d3">{profile.tagline}</p>
      <div class="hero-cta reveal d4">
        <a class="btn solid" href="#projects"><Icon name="arrow-down" /> View projects</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        <a class="btn" href={profile.resumeUrl} target="_blank" rel="noopener"><Icon name="file" /> Resume</a>
      </div>
    </div>

    <div class="hero-strip mono reveal d4" aria-hidden="true">
      <span>CAN</span><span class="dot">·</span>
      <span>SecOC</span><span class="dot">·</span>
      <span>IdsM / IdsR</span><span class="dot">·</span>
      <span>SOME/IP</span><span class="dot">·</span>
      <span>AUTOSAR</span><span class="dot">·</span>
      <span>SDV</span>
    </div>
  </div>
</header>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(900px 420px at 80% -10%, var(--glow-a), transparent 60%),
      radial-gradient(700px 380px at 10% 110%, var(--glow-b), transparent 60%);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-right { display: flex; align-items: center; gap: 20px; }

  .nav-links { display: flex; gap: 22px; font-size: 13px; }
  .nav-links a { color: var(--ink-dim); transition: color 140ms ease; }
  .nav-links a:hover { color: var(--accent); }

  button[data-theme-toggle] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: none;
    color: var(--ink-dim);
    cursor: pointer;
    transition: border-color 140ms ease, color 140ms ease;
  }

  button[data-theme-toggle]:hover { border-color: var(--accent); color: var(--accent); }

  .icon-moon { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: block; }
  :global([data-theme="dark"]) .icon-sun { display: none; }

  .hero-body { padding: clamp(56px, 10vw, 130px) 0 clamp(28px, 5vw, 56px); }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(46px, 8.5vw, 92px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin: 16px 0 22px;
  }

  h1 em { font-style: italic; color: var(--accent); }

  .lede {
    color: var(--ink-dim);
    font-size: clamp(16px, 2vw, 19px);
    max-width: 56ch;
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .hero-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 18px 0 26px;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .hero-strip .dot { color: var(--accent); }

  @media (max-width: 560px) {
    .nav-links { display: none; }
  }
</style>
